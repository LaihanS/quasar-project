{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "module": "esnext",
    "baseUrl": ".",
    "paths": {
      "composables": ["src/composables/index.ts"],
      "models": ["src/models/index.ts"],
      "api": ["src/api/index.ts"],
      "api/*": ["src/api/*"],
      "utils/*": ["src/utils/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "pages/*": ["src/pages/*"],
      "plugins/*": ["src/plugins/*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "src/*": ["src/*"],
      "app/*": ["*"]
    }
  },
  "exclude": ["dist", ".quasar", "node_modules", "src-capacitor"]
}
